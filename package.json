{
  "name": "werewolf-game",
  "private": true,
  "version": "1.1.0",
  "type": "module",
  "description": "小学生・タブレット向け 人狼ゲーム Webアプリ (PWA対応)",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "icons": "node scripts/generate-icons.mjs",
    "fonts": "node scripts/build-fonts.mjs",
    "test": "vitest run",
    "check": "node scripts/check-project.mjs"
  },
  "dependencies": {
    "lucide-react": "^0.400.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.19",
    "postcss": "^8.4.39",
    "sharp": "^0.33.4",
    "tailwindcss": "^3.4.6",
    "typescript": "^5.5.3",
    "vite": "^5.3.4",
    "vite-plugin-pwa": "^0.21.2",
    "vitest": "^2.1.9"
  }
}
